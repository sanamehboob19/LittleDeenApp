<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused State (When child taps to type - primary lavender border) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface" />
            <corners android:radius="@dimen/_16sdp" />
            <stroke
                android:width="@dimen/_2sdp"
                android:color="@color/color_primary" />
        </shape>
    </item>

    <!-- Normal / Default State (Soft subtle border) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface" />
            <corners android:radius="@dimen/_16sdp" />
            <stroke
                android:width="@dimen/_1sdp"
                android:color="@color/color_border" />
        </shape>
    </item>

</selector>