<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B10">

    <!-- LEFT PANEL: Back & Tools -->
    <LinearLayout
        android:id="@+id/leftDock"
        android:layout_width="@dimen/_54sdp"
        android:layout_height="match_parent"
        android:background="#12141F"
        android:elevation="@dimen/_4sdp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            app:cardBackgroundColor="#212638"
            app:cardCornerRadius="@dimen/_15sdp"
            app:cardElevation="0dp"
            app:strokeColor="#3D4566"
            app:strokeWidth="@dimen/_1sdp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/_7sdp"
                android:rotation="180"
                android:src="@drawable/ic_check"
                app:tint="@android:color/white" />
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="@dimen/_24sdp"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/_4sdp"
            android:background="#2A3045" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- Eraser -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolEraser"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    app:cardBackgroundColor="#212638"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:strokeColor="#3D4566"
                    app:strokeWidth="@dimen/_1sdp">
                    <TextView
                        android:id="@+id/tvToolEraser"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🧼"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_12ssp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Neon Pen -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolGlowPen"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    app:cardBackgroundColor="#00F0FF"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:strokeWidth="0dp">
                    <TextView
                        android:id="@+id/tvToolGlowPen"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="✨"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/_12ssp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Brush -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolBrush"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    app:cardBackgroundColor="#212638"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:strokeColor="#3D4566"
                    app:strokeWidth="@dimen/_1sdp">
                    <TextView
                        android:id="@+id/tvToolBrush"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🖌️"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_12ssp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Line -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolLine"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    app:cardBackgroundColor="#212638"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:strokeColor="#3D4566"
                    app:strokeWidth="@dimen/_1sdp">
                    <TextView
                        android:id="@+id/tvToolLine"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="—"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_12ssp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Rect -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolRectangle"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    app:cardBackgroundColor="#212638"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:strokeColor="#3D4566"
                    app:strokeWidth="@dimen/_1sdp">
                    <TextView
                        android:id="@+id/tvToolRectangle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="▭"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_12ssp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Circle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolCircle"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_36sdp"
                    app:cardBackgroundColor="#212638"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:strokeColor="#3D4566"
                    app:strokeWidth="@dimen/_1sdp">
                    <TextView
                        android:id="@+id/tvToolCircle"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="◯"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/_12ssp" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- CENTER PITCH BLACK CANVAS -->
    <com.ccx.islamic.kids.littledeenapp.ui.customViews.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightDock"
        app:layout_constraintStart_toEndOf="@id/leftDock"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- RIGHT PANEL: Actions & 2-Column Neon Colors -->
    <LinearLayout
        android:id="@+id/rightDock"
        android:layout_width="@dimen/_110sdp"
        android:layout_height="match_parent"
        android:background="#12141F"
        android:elevation="@dimen/_4sdp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_6sdp"
        android:paddingVertical="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnRotateScreen"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                app:cardBackgroundColor="#212638"
                app:cardCornerRadius="@dimen/_13sdp"
                app:strokeColor="#3D4566"
                app:strokeWidth="@dimen/_1sdp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🔄"
                    android:textSize="@dimen/_10ssp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSave"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                app:cardBackgroundColor="#212638"
                app:cardCornerRadius="@dimen/_13sdp"
                app:strokeColor="#3D4566"
                app:strokeWidth="@dimen/_1sdp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="💾"
                    android:textSize="@dimen/_10ssp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnShare"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                app:cardBackgroundColor="#212638"
                app:cardCornerRadius="@dimen/_13sdp"
                app:strokeColor="#3D4566"
                app:strokeWidth="@dimen/_1sdp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="↗️"
                    android:textSize="@dimen/_10ssp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnUndo"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                app:cardBackgroundColor="#212638"
                app:cardCornerRadius="@dimen/_13sdp"
                app:strokeColor="#3D4566"
                app:strokeWidth="@dimen/_1sdp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="↩"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_11ssp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnRedo"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                app:cardBackgroundColor="#212638"
                app:cardCornerRadius="@dimen/_13sdp"
                app:strokeColor="#3D4566"
                app:strokeWidth="@dimen/_1sdp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="↪"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_11ssp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTrash"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                app:cardBackgroundColor="#212638"
                app:cardCornerRadius="@dimen/_13sdp"
                app:strokeColor="#3D4566"
                app:strokeWidth="@dimen/_1sdp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🗑"
                    android:textSize="@dimen/_10ssp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderStrokeSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="2.0"
            android:value="20.0"
            android:valueFrom="6.0"
            android:valueTo="80.0"
            app:thumbColor="#00F0FF"
            app:trackColorActive="#00F0FF"
            app:trackColorInactive="#2A3045" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvColors"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:listitem="@layout/item_color_swatch" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>