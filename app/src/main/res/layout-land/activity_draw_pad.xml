<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- ============================================== -->
    <!-- 1. LEFT DOCK: Back Button & Tools               -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/leftDock"
        android:layout_width="@dimen/_54sdp"
        android:layout_height="match_parent"
        android:background="#FAF9FE"
        android:elevation="@dimen/_4sdp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            app:cardBackgroundColor="@color/color_primary"
            app:cardCornerRadius="@dimen/_16sdp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/_7sdp"
                android:rotation="180"
                android:src="@drawable/ic_check"
                app:tint="@android:color/white" />
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="@dimen/_28sdp"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/_6sdp"
            android:background="#E0E0E0" />

        <!-- Vertical Scroll for Tools -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- 1. Pencil -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolPencil"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginBottom="@dimen/_4sdp"
                    app:cardBackgroundColor="@color/color_primary"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✏️"
                            android:textSize="@dimen/_11ssp" />

                        <TextView
                            android:id="@+id/tvToolPencil"
                            style="@style/TextAppearance.LittleDeen.H5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pencil"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_7ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Brush -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolBrush"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginBottom="@dimen/_4sdp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EAEAEA"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🖌️"
                            android:textSize="@dimen/_11ssp" />

                        <TextView
                            android:id="@+id/tvToolBrush"
                            style="@style/TextAppearance.LittleDeen.H5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Brush"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_7ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Line -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolLine"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginBottom="@dimen/_4sdp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EAEAEA"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvToolLine"
                            style="@style/TextAppearance.LittleDeen.H5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Line"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_7ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Rectangle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolRectangle"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginBottom="@dimen/_4sdp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EAEAEA"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▭"
                            android:textSize="@dimen/_11ssp" />

                        <TextView
                            android:id="@+id/tvToolRectangle"
                            style="@style/TextAppearance.LittleDeen.H5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rect"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_7ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Circle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolCircle"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginBottom="@dimen/_4sdp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EAEAEA"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="◯"
                            android:textSize="@dimen/_11ssp" />

                        <TextView
                            android:id="@+id/tvToolCircle"
                            style="@style/TextAppearance.LittleDeen.H5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Circle"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_7ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 6. Eraser -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolEraser"
                    android:layout_width="@dimen/_42sdp"
                    android:layout_height="@dimen/_36sdp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/_10sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EAEAEA"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧼"
                            android:textSize="@dimen/_11ssp" />

                        <TextView
                            android:id="@+id/tvToolEraser"
                            style="@style/TextAppearance.LittleDeen.H5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Eraser"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_7ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ============================================== -->
    <!-- 2. CENTER CANVAS: MAXIMUM FULL DRAWING AREA    -->
    <!-- ============================================== -->
    <com.ccx.islamic.kids.littledeenapp.ui.customViews.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightDock"
        app:layout_constraintStart_toEndOf="@id/leftDock"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================================== -->
    <!-- 3. RIGHT DOCK: Actions, Slider & 30 Colors     -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/rightDock"
        android:layout_width="@dimen/_120sdp"
        android:layout_height="match_parent"
        android:background="#FAF9FE"
        android:elevation="@dimen/_4sdp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_6sdp"
        android:paddingVertical="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Row 1: Rotate, Save, Share -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnRotateScreen"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeColor="#EAEAEA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🔄"
                    android:textSize="@dimen/_11ssp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSave"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeColor="#EAEAEA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="💾"
                    android:textSize="@dimen/_11ssp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnShare"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeColor="#EAEAEA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="↗️"
                    android:textSize="@dimen/_11ssp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Row 2: Undo, Redo, Trash -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnUndo"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeColor="#EAEAEA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="↩"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_12ssp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnRedo"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeColor="#EAEAEA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="↪"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_12ssp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTrash"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeColor="#EAEAEA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🗑"
                    android:textSize="@dimen/_11ssp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Compact Stroke Slider -->
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderStrokeSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:stepSize="2.0"
            android:value="16.0"
            android:valueFrom="4.0"
            android:valueTo="80.0"
            app:thumbColor="@color/color_primary"
            app:trackColorActive="@color/color_primary"
            app:trackColorInactive="#E0E0E0" />

        <!-- 30 Colors Grid (2 columns, vertical scrolling) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvColors"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingVertical="@dimen/_2sdp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:listitem="@layout/item_color_swatch" />

    </LinearLayout>

    <!-- Hidden Title reference so ViewBinding never crashes -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>