<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#150E28">

    <!-- Night Sky Background Artwork -->
    <ImageView
        android:id="@+id/ivSplashNightBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash_night"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Guideline for perfect vertical balance -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.28" />

    <!-- App Name (Cooper Font, Glowing White) -->
    <TextView
        android:id="@+id/tvAppName"
        style="@style/TextAppearance.LittleDeen.H1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="@dimen/_36ssp"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="4"
        android:shadowRadius="10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guideCenter" />

    <!-- Subtitle: Learn • Pray • Grow -->
    <TextView
        android:id="@+id/tvSubtitle"
        style="@style/TextAppearance.LittleDeen.H5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:letterSpacing="0.10"
        android:text="@string/splash_sub_title"
        android:textColor="@color/color_accent"
        android:textSize="@dimen/_14ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAppName" />

    <!-- Gradient Accent Divider -->
    <View
        android:id="@+id/viewWelcomeDivider"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:background="@drawable/bg_welcome_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle" />

    <!-- Modern Dreamy Frosted Welcome Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWelcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_24sdp"
        app:cardBackgroundColor="#4D2E1F5E"
        app:cardCornerRadius="@dimen/_24sdp"
        app:cardElevation="@dimen/_6sdp"
        app:strokeColor="#40FFFFFF"
        app:strokeWidth="@dimen/_1sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewWelcomeDivider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingVertical="@dimen/_22sdp">

            <!-- Floating Crescent Moon Icon -->
<!--            <ImageView-->
<!--                android:layout_width="@dimen/_26sdp"-->
<!--                android:layout_height="@dimen/_26sdp"-->
<!--                android:contentDescription="@null"-->
<!--                android:src="@drawable/ic_crescent_moon" />-->

            <!-- Greeting: Assalamu Alaikum! -->
            <TextView
                android:id="@+id/tvGreeting"
                style="@style/TextAppearance.LittleDeen.H4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:text="@string/splash_welcome_greeting"
                android:textColor="@color/color_primary_light"
                android:textSize="@dimen/_17ssp" />

            <!-- Welcome to Little Deen -->
            <TextView
                android:id="@+id/tvWelcomeMessage"
                style="@style/TextAppearance.LittleDeen.H2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:gravity="center"
                android:text="@string/splash_welcome_title"
                android:textColor="@color/white"
                android:textSize="@dimen/_20ssp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
