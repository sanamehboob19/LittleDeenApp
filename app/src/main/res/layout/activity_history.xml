<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app">

    <!-- ============================================== -->
    <!-- 1. TOP HEADER BAR (Back + Title + Clear Icon)  -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/_17sdp"
            app:cardElevation="@dimen/_1sdp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/_1sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Back"
                android:padding="@dimen/_8sdp"
                android:rotation="180"
                android:src="@drawable/ic_check"
                app:tint="@color/color_text_primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Title -->
        <TextView
            android:id="@+id/tvHeaderTitle"
            style="@style/TextAppearance.LittleDeen.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Watch History"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/_16ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Clear All / Delete Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnClearHistory"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/_17sdp"
            app:cardElevation="@dimen/_1sdp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/_1sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🗑️"
                android:textSize="@dimen/_14ssp" />
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================== -->
    <!-- 2. DATE-WISE FILTER CHIPS BAR                  -->
    <!-- ============================================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistoryFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_6sdp"
        app:layout_constraintTop_toBottomOf="@id/headerBar" />

    <!-- ============================================== -->
    <!-- 3. COMPACT HISTORY VIDEOS LIST                 -->
    <!-- ============================================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistoryVideos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingTop="@dimen/_4sdp"
        android:paddingBottom="@dimen/_20sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvHistoryFilters" />

    <!-- ============================================== -->
    <!-- 4. EMPTY STATE                                 -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/layoutEmptyHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🕒"
            android:textSize="@dimen/_36ssp" />

        <TextView
            style="@style/TextAppearance.LittleDeen.H4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="No watch history"
            android:textColor="@color/color_text_primary" />

        <TextView
            style="@style/TextAppearance.LittleDeen.P5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="Videos watched in this time range will show here."
            android:textColor="@color/color_text_secondary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>