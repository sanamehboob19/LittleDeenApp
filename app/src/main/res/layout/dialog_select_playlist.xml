<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/_24sdp"
    app:cardElevation="@dimen/_10sdp"
    app:strokeColor="@color/color_border"
    app:strokeWidth="@dimen/_1sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_14sdp"
        android:paddingBottom="@dimen/_24sdp">

        <!-- Top Drag Handle -->
        <View
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_4sdp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_input_field" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.LittleDeen.H3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add to Custom Playlist 📂"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/_15ssp" />

            <ImageView
                android:id="@+id/btnClosePlaylistDialog"
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="@dimen/_4sdp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/color_text_tertiary" />
        </LinearLayout>

        <!-- 🎯 Direct RecyclerView without NestedScrollView layout bugs -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSelectPlaylists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:overScrollMode="never" />

        <!-- Create New Playlist Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateNewPlaylist"
            style="@style/TextAppearance.LittleDeen.H4"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:backgroundTint="@color/color_primary_light"
            android:text="+ Create New Playlist"
            android:textAllCaps="false"
            android:textColor="@color/color_primary"
            app:cornerRadius="@dimen/_14sdp"
            app:elevation="0dp"
            app:strokeColor="@color/color_primary"
            app:strokeWidth="@dimen/_1sdp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>