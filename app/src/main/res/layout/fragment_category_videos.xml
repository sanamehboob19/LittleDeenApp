<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app">

    <!-- ============================================== -->
    <!-- 1. SKELETON SHIMMER LOADING                    -->
    <!-- ============================================== -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerCategoryVideos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingTop="@dimen/_8sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_140sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                android:background="@drawable/bg_input_field" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_140sdp"
                android:background="@drawable/bg_input_field" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- ============================================== -->
    <!-- 2. PULL TO REFRESH + CATEGORY VIDEOS LIST      -->
    <!-- ============================================== -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshCategory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategoryVideos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_75sdp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ============================================== -->
    <!-- 3. EMPTY STATE                                 -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/layoutCategoryEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📂"
            android:textSize="@dimen/_36ssp" />

        <TextView
            style="@style/TextAppearance.LittleDeen.H4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="No videos in this category"
            android:textColor="@color/color_text_primary" />

        <TextView
            style="@style/TextAppearance.LittleDeen.P5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="Check back later for new safe content!"
            android:textColor="@color/color_text_secondary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>