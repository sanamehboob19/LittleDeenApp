<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 1. Fullscreen Background Image (9:16 Artwork covers entire display) -->
    <ImageView
        android:id="@+id/ivSlideImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Slide Background"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/img_onboarding_4" />

    <!-- 2. Smooth Dark Gradient Scrim (Bottom 55% of the screen) -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_bottom_gradient_scrim"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHeight_percent="0.60"
        app:layout_constraintVertical_bias="1.0" />

    <!-- 3. Text Section (Title & Description positioned over the dark scrim) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingBottom="@dimen/_110sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Slide Title -->
        <TextView
            android:id="@+id/tvSlideTitle"
            style="@style/TextAppearance.LittleDeen.H2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_20ssp"
            tools:text="Safe from the Wild Internet 🛡️" />

        <!-- Accent Underline Pill -->
        <View
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_welcome_divider"
            android:backgroundTint="@color/color_primary" />

        <!-- Slide Description -->
        <TextView
            android:id="@+id/tvSlideDesc"
            style="@style/TextAppearance.LittleDeen.P4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:lineSpacingExtra="@dimen/_4sdp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="#F0F0F0"
            android:textSize="@dimen/_11ssp"
            tools:text="No unpredictable ads, no harmful content, and no external popups. Little Deen is a 100% escape-proof garden built to protect your child's pure heart." />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>














