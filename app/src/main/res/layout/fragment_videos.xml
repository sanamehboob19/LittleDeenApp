<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app">

    <!-- ============================================== -->
    <!-- 1. TOP 4 SMART HUB CARDS (NO SCROLLING - 1 ROW)-->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/layoutTopHub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_6sdp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Card 1: All Videos (Default Selected) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTabAll"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginEnd="@dimen/_3sdp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/color_primary"
            app:cardCornerRadius="@dimen/_14sdp"
            app:cardElevation="@dimen/_2sdp"
            app:strokeColor="@color/color_primary"
            app:strokeWidth="@dimen/_1sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏠"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    android:id="@+id/tvTabAllLabel"
                    style="@style/TextAppearance.LittleDeen.H5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Watch History -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTabHistory"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/_14sdp"
            app:cardElevation="@dimen/_1sdp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/_1sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕒"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    android:id="@+id/tvTabHistoryLabel"
                    style="@style/TextAppearance.LittleDeen.H5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: Favorites -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTabFavorites"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginHorizontal="@dimen/_3sdp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/_14sdp"
            app:cardElevation="@dimen/_1sdp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/_1sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❤️"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    android:id="@+id/tvTabFavLabel"
                    style="@style/TextAppearance.LittleDeen.H5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Favorites"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 4: Categories -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTabCategories"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginStart="@dimen/_3sdp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/_14sdp"
            app:cardElevation="@dimen/_1sdp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/_1sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📂"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    android:id="@+id/tvTabCatLabel"
                    style="@style/TextAppearance.LittleDeen.H5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categories"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ============================================== -->
    <!-- 2. SECTION SUBTITLE                            -->
    <!-- ============================================== -->
    <TextView
        android:id="@+id/tvSectionTitle"
        style="@style/TextAppearance.LittleDeen.H4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingTop="@dimen/_4sdp"
        android:text="All Videos Feed"
        android:textColor="@color/color_text_secondary"
        android:textSize="@dimen/_11ssp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTopHub" />

    <!-- ============================================== -->
    <!-- 3. SKELETON SHIMMER LOADING                    -->
    <!-- ============================================== -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerVideos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingTop="@dimen/_6sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSectionTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_140sdp"
                android:layout_marginBottom="@dimen/_12sdp"
                android:background="@drawable/bg_input_field" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/_140sdp"
                android:background="@drawable/bg_input_field" />
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- ============================================== -->
    <!-- 4. VIDEOS LIST + PULL TO REFRESH               -->
    <!-- ============================================== -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshVideos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_4sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSectionTitle">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVideos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingTop="@dimen/_2sdp"
            android:paddingBottom="@dimen/_75sdp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ============================================== -->
    <!-- 5. EMPTY STATE (For Empty History / Favorites) -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/layoutEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSectionTitle">

        <TextView
            android:id="@+id/tvEmptyIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📺"
            android:textSize="@dimen/_36ssp" />

        <TextView
            android:id="@+id/tvEmptyTitle"
            style="@style/TextAppearance.LittleDeen.H4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="No videos yet"
            android:textColor="@color/color_text_primary" />

        <TextView
            android:id="@+id/tvEmptySubtitle"
            style="@style/TextAppearance.LittleDeen.P5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:text="Explore videos and tap ❤️ to save them here!"
            android:textColor="@color/color_text_secondary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>