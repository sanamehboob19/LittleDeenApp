<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/_24sdp"
    app:cardElevation="@dimen/_10sdp"
    app:strokeColor="@color/color_border"
    app:strokeWidth="@dimen/_1sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_20sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingBottom="@dimen/_20sdp">

        <!-- Top Drag Pill / Indicator -->
        <View
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_4sdp"
            android:background="@drawable/bg_input_field" />

        <!-- Cute Mascot / Leaving Emoji -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_12sdp"
            android:text="👋"
            android:textSize="@dimen/_36ssp" />

        <!-- Dialog Title -->
        <TextView
            android:id="@+id/tvExitTitle"
            style="@style/TextAppearance.LittleDeen.H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="Leaving so soon?"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/_18ssp" />

        <!-- Streak Warning Subtitle -->
        <TextView
            style="@style/TextAppearance.LittleDeen.P4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:gravity="center"
            android:text="Come back tomorrow to keep your learning streak alive! 🔥"
            android:textColor="@color/color_text_secondary" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18sdp"
            android:orientation="horizontal">

            <!-- Stay & Play (Primary) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStay"
                style="@style/TextAppearance.LittleDeen.H4"
                android:layout_width="0dp"
                android:layout_height="@dimen/_46sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:layout_weight="1.2"
                android:backgroundTint="@color/color_primary"
                android:text="Stay &amp; Learn"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="@dimen/_14sdp"
                app:elevation="@dimen/_2sdp" />

            <!-- Exit App (Secondary) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExit"
                style="@style/TextAppearance.LittleDeen.H5"
                android:layout_width="0dp"
                android:layout_height="@dimen/_46sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_weight="0.8"
                android:backgroundTint="#FFEBEE"
                android:text="Exit App"
                android:textAllCaps="false"
                android:textColor="#D32F2F"
                app:cornerRadius="@dimen/_14sdp"
                app:elevation="0dp"
                app:strokeColor="#FFCDD2"
                app:strokeWidth="@dimen/_1sdp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>