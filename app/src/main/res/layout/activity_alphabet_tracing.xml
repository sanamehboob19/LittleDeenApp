<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app">

    <!-- Top Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/_17sdp"
            app:cardElevation="@dimen/_1sdp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/_1sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/color_text_primary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvLetterTitle"
            style="@style/TextAppearance.LittleDeen.H3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:gravity="center"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/_15ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnReset"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Letter A for Apple 🍎" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnReset"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/_17sdp"
            app:cardElevation="@dimen/_1sdp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/_1sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🔄"
                android:textSize="@dimen/_14ssp" />
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tracing Stage White Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTracingStage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/_14sdp"
        android:layout_marginVertical="@dimen/_10sdp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/_24sdp"
        app:cardElevation="@dimen/_4sdp"
        app:strokeColor="@color/color_border"
        app:strokeWidth="@dimen/_1sdp"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutTopBar">

        <com.ccx.islamic.kids.littledeenapp.ui.customViews.AlphabetTracingView
            android:id="@+id/alphabetTracingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Prev / Next Controls -->
    <LinearLayout
        android:id="@+id/layoutBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/_14sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrevLetter"
            style="@style/TextAppearance.LittleDeen.H4"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:backgroundTint="#F5F5F5"
            android:text="← Prev"
            android:textAllCaps="false"
            android:textColor="@color/color_text_primary"
            app:cornerRadius="@dimen/_14sdp"
            app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextLetter"
            style="@style/TextAppearance.LittleDeen.H4"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:backgroundTint="@color/color_primary"
            android:text="Next →"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:cornerRadius="@dimen/_14sdp"
            app:elevation="@dimen/_2sdp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>