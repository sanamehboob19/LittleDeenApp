<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardSalahRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_10sdp"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/_20sdp"
    app:cardElevation="@dimen/_2sdp"
    app:strokeColor="@color/color_border"
    app:strokeWidth="@dimen/_1sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_12sdp">

        <!-- Step Number Badge Circle -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            app:cardBackgroundColor="#FFF8E1"
            app:cardCornerRadius="@dimen/_21sdp"
            app:cardElevation="0dp"
            app:strokeColor="#FFE082"
            app:strokeWidth="@dimen/_1sdp">

            <TextView
                android:id="@+id/tvStepNum"
                style="@style/TextAppearance.LittleDeen.H3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#E65100"
                android:textSize="@dimen/_13ssp"
                tools:text="1" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Step Titles -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStepTitle"
                style="@style/TextAppearance.LittleDeen.H4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/_13ssp"
                tools:text="1. Making Wudu (Ablution)" />

            <TextView
                android:id="@+id/tvStepSubtitle"
                style="@style/TextAppearance.LittleDeen.P5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/_10ssp"
                tools:text="Cleanliness is half of faith" />
        </LinearLayout>

        <!-- Arrow Hint -->
        <TextView
            style="@style/TextAppearance.LittleDeen.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/color_text_tertiary"
            android:textSize="@dimen/_20ssp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>