<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardHistoryRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_8sdp"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/_12sdp"
    app:cardElevation="@dimen/_1sdp"
    app:strokeColor="@color/color_border"
    app:strokeWidth="@dimen/_1sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_8sdp">

        <!-- Thumbnail (Compact Size: 90x56) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/_90sdp"
            android:layout_height="@dimen/_56sdp"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivHistoryThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Thumbnail"
                android:scaleType="centerCrop"
                tools:src="@drawable/bg_input_field" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Title & Timestamp Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHistoryTitle"
                style="@style/TextAppearance.LittleDeen.H5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/_11ssp"
                tools:text="Prophet Yunus (AS) &amp; The Whale - Stories for Kids" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvHistoryChannel"
                    style="@style/TextAppearance.LittleDeen.P5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/_9ssp"
                    tools:text="One 4 Kids (Zaky)" />

                <TextView
                    android:id="@+id/tvHistoryTime"
                    style="@style/TextAppearance.LittleDeen.P5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_tertiary"
                    android:textSize="@dimen/_8ssp"
                    tools:text="Today, 02:45 PM" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>