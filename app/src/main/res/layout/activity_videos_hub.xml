<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app">

    <!-- ============================================== -->
    <!-- 1. TOP MODERN HEADER BAR                       -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingBottom="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/_18sdp"
            app:cardElevation="@dimen/_1sdp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/_1sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Back"
                android:padding="@dimen/_9sdp"
                android:rotation="180"
                android:src="@drawable/ic_check"
                app:tint="@color/color_text_primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Screen Title -->
        <TextView
            android:id="@+id/tvHeaderTitle"
            style="@style/TextAppearance.LittleDeen.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YouTube Hub"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/_16ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Search Icon Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSearchHub"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/_18sdp"
            app:cardElevation="@dimen/_1sdp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/_1sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔍"
                android:textSize="@dimen/_14ssp" />
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================== -->
    <!-- 2. SCROLLABLE CONTENT CONTAINER                -->
    <!-- ============================================== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingTop="@dimen/_4sdp"
            android:paddingBottom="@dimen/_32sdp">

            <!-- HERO FEATURE CARD: Custom Playlists -->
            <!-- 1. TOP CUSTOM PLAYLISTS BANNER (Hidden for now) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCustomPlaylistsBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/color_primary"
                app:cardCornerRadius="@dimen/_24sdp"
                app:cardElevation="@dimen/_6sdp"
                app:strokeColor="@color/color_primary_light"
                app:strokeWidth="@dimen/_1sdp">
                <!-- (keep inner layout as is) -->
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. QUICK ACCESS ROW (Hidden for now) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:visibility="gone"
                android:orientation="horizontal">
                <!-- (keep inner layout as is) -->
            </LinearLayout>

            <!-- QUICK ACCESS ROW (History & Liked Favorites) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="@dimen/_12sdp"
                android:orientation="horizontal">

                <!-- History Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHubHistory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="@dimen/_18sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/_12sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🕒"
                            android:textSize="@dimen/_22ssp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.LittleDeen.H4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="History"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/_12ssp" />

                            <TextView
                                style="@style/TextAppearance.LittleDeen.P5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recently watched"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="@dimen/_9ssp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Favorites Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHubFavorites"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="@dimen/_18sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/_12sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❤️"
                            android:textSize="@dimen/_22ssp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.LittleDeen.H4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Liked Videos"
                                android:textColor="@color/color_text_primary"
                                android:textSize="@dimen/_12ssp" />

                            <TextView
                                style="@style/TextAppearance.LittleDeen.P5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Saved favorites"
                                android:textColor="@color/color_text_secondary"
                                android:textSize="@dimen/_9ssp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- SECTION HEADER: BROWSE CATEGORIES -->
            <TextView
                android:id="@+id/tvBrowseTitle"
                style="@style/TextAppearance.LittleDeen.H3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:text="📂 Browse by Categories"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/_16ssp" />

            <TextView
                style="@style/TextAppearance.LittleDeen.P5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="Tap any category to explore themed video playlists"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/_10ssp" />

            <!-- FULL-WIDTH CATEGORIES LIST RECYCLERVIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHubCategoriesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>