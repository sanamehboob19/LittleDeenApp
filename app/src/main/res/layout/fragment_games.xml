<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingBottom="@dimen/_75sdp">

            <!-- ============================================== -->
            <!-- 1. GAMES HERO BANNER (Dynamic Theme)          -->
            <!-- ============================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGamesHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_28sdp"
                app:cardElevation="@dimen/_6sdp">

                <FrameLayout
                    android:id="@+id/flGamesBannerBg"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_130sdp"
                    android:background="@color/color_primary">

                    <!-- Decorative glass circles -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="-40dp"
                        android:layout_marginEnd="-30dp"
                        app:cardBackgroundColor="#26FFFFFF"
                        app:cardCornerRadius="70dp"
                        app:cardElevation="0dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="start|bottom"
                        android:layout_marginStart="-20dp"
                        android:layout_marginBottom="-30dp"
                        app:cardBackgroundColor="#1AFFFFFF"
                        app:cardCornerRadius="40dp"
                        app:cardElevation="0dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_16sdp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.LittleDeen.H2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Play &amp; Learn 🎮"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_18ssp" />

                            <TextView
                                style="@style/TextAppearance.LittleDeen.P5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:text="Boost your creativity with safe, fun mini-games!"
                                android:textColor="#E8FFF3"
                                android:textSize="@dimen/_11ssp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:elevation="@dimen/_4sdp"
                            android:text="🎨"
                            android:textSize="@dimen/_45ssp" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.LittleDeen.H3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚀 Creative Zone"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_16ssp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_2sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_weight="1"
                    android:background="@color/color_primary_light" />
            </LinearLayout>

            <TextView
                style="@style/TextAppearance.LittleDeen.P5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:text="Pick a game and start creating!"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/_10ssp" />

            <!-- ============================================== -->
            <!-- FEATURED GAME: DRAWING PAD (Main Focus)       -->
            <!-- ============================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDrawingPad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                app:cardBackgroundColor="#E65100"
                app:cardCornerRadius="@dimen/_24sdp"
                app:cardElevation="@dimen/_5sdp"
                app:strokeColor="#FFB74D"
                app:strokeWidth="@dimen/_2sdp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_grad_streak">

                    <!-- White glow circle -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="-20dp"
                        app:cardBackgroundColor="#33FFFFFF"
                        app:cardCornerRadius="40dp"
                        app:cardElevation="0dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/_16sdp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/_55sdp"
                            android:layout_height="@dimen/_55sdp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="@dimen/_27sdp"
                            app:cardElevation="@dimen/_4sdp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="🎨"
                                android:textSize="@dimen/_28ssp" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_14sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TextAppearance.LittleDeen.H2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Drawing Pad"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_16ssp" />

                            <TextView
                                style="@style/TextAppearance.LittleDeen.P5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:text="Draw your imagination!"
                                android:textColor="@color/black"
                                android:textSize="@dimen/_11ssp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_24ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!-- ROW 1: Magic Coloring & Neon Pad              -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:orientation="horizontal">

                <!-- Magic Coloring (Pink) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardShapesTracing"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_105sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFF3E0"
                    app:cardCornerRadius="@dimen/_24sdp"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeColor="#FFB74D"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_grad_cat_duas"
                        android:gravity="center"
                        android:orientation="vertical">

                        <!-- Circular Badge -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/_42sdp"
                            android:layout_height="@dimen/_42sdp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="@dimen/_21sdp"
                            app:cardElevation="@dimen/_2sdp"
                            app:strokeColor="#FFE0B2"
                            app:strokeWidth="@dimen/_2sdp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="🔺"
                                android:textSize="@dimen/_20ssp" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            style="@style/TextAppearance.LittleDeen.H4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:text="Learn Shapes"
                            android:textColor="#E65100"
                            android:textSize="@dimen/_12ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>




                <!-- Neon Pad (Indigo) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNeonPad"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_105sdp"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#E8EAF6"
                    app:cardCornerRadius="@dimen/_24sdp"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeColor="#9FA8DA"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/_42sdp"
                            android:layout_height="@dimen/_42sdp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="@dimen/_21sdp"
                            app:cardElevation="@dimen/_2sdp"
                            app:strokeColor="#C5CAE9"
                            app:strokeWidth="@dimen/_2sdp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="🌟"
                                android:textSize="@dimen/_20ssp" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            style="@style/TextAppearance.LittleDeen.H4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:text="Neon Pad"
                            android:textColor="#3949AB"
                            android:textSize="@dimen/_12ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ============================================== -->
            <!-- ROW 2: ABC Tracing & 123 Tracing              -->
            <!-- ============================================== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:orientation="horizontal">

                <!-- ABC Tracing (Blue) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAbcTracing"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_105sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#E3F2FD"
                    app:cardCornerRadius="@dimen/_24sdp"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeColor="#90CAF9"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_grad_activities"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/_42sdp"
                            android:layout_height="@dimen/_42sdp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="@dimen/_21sdp"
                            app:cardElevation="@dimen/_2sdp"
                            app:strokeColor="#BBDEFB"
                            app:strokeWidth="@dimen/_2sdp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="🔤"
                                android:textSize="@dimen/_20ssp" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            style="@style/TextAppearance.LittleDeen.H4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:text="ABC Tracing"
                            android:textColor="#1976D2"
                            android:textSize="@dimen/_12ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 123 Tracing (Green) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card123Tracing"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_105sdp"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#E8F5E9"
                    app:cardCornerRadius="@dimen/_24sdp"
                    app:cardElevation="@dimen/_4sdp"
                    app:strokeColor="#A5D6A7"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_grad_cat_stories"
                        android:gravity="center"
                        android:orientation="vertical">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="@dimen/_42sdp"
                            android:layout_height="@dimen/_42sdp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="@dimen/_21sdp"
                            app:cardElevation="@dimen/_2sdp"
                            app:strokeColor="#C8E6C9"
                            app:strokeWidth="@dimen/_2sdp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="🔢"
                                android:textSize="@dimen/_20ssp" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            style="@style/TextAppearance.LittleDeen.H4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:text="123 Tracing"
                            android:textColor="#388E3C"
                            android:textSize="@dimen/_12ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ============================================== -->
            <!-- ROW 3: Pixel Art (Full Width Bottom Feature)  -->
            <!-- ============================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPixelArt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                app:cardBackgroundColor="#F3E5F5"
                app:cardCornerRadius="@dimen/_24sdp"
                app:cardElevation="@dimen/_4sdp"
                app:strokeColor="#CE93D8"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_grad_cat_videos"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_14sdp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/_46sdp"
                        android:layout_height="@dimen/_46sdp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="@dimen/_23sdp"
                        app:cardElevation="@dimen/_3sdp"
                        app:strokeColor="#E1BEE7"
                        app:strokeWidth="@dimen/_2sdp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="👾"
                            android:textSize="@dimen/_22ssp" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.LittleDeen.H3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pixel Art"
                            android:textColor="#6A1B9A"
                            android:textSize="@dimen/_14ssp" />

                        <TextView
                            style="@style/TextAppearance.LittleDeen.P5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:text="Color by numbers!"
                            android:textColor="#8E24AA"
                            android:textSize="@dimen/_10ssp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#7B1FA2"
                        android:textSize="@dimen/_22ssp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>