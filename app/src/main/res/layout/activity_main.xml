<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app">

    <!-- ============================================== -->
    <!-- 1. TOP HEADER BAR                              -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_6sdp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Child Avatar & App Name -->
        <LinearLayout
            android:id="@+id/layoutAppBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Circular Avatar Ring -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTopAvatar"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="@dimen/_1sdp"
                app:strokeColor="@color/color_primary"
                app:strokeWidth="@dimen/_1sdp">

                <ImageView
                    android:id="@+id/ivAppLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Child Avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_boy_1" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvAppName"
                style="@style/TextAppearance.LittleDeen.H3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:text="Little Deen"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/_15ssp" />
        </LinearLayout>

        <!-- Right Action Icons: Music Toggle, Notification, Exit -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 🔍 Search Icon Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSearch"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="@dimen/_1sdp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🔍"
                    android:textSize="@dimen/_13ssp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Background Music Quick Toggle -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMusicToggle"
                android:layout_width="@dimen/_32sdp"
                android:visibility="gone"
                android:layout_height="@dimen/_32sdp"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="@dimen/_1sdp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="@dimen/_1sdp">

                <ImageView
                    android:id="@+id/ivMusicToggle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_volume_up"
                    app:tint="@color/color_primary" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Notifications Icon -->
            <!-- Settings Icon (Replaced Notification Bell) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettings"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginStart="@dimen/_8sdp"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="@dimen/_1sdp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="@dimen/_1sdp">

                <ImageView
                    android:id="@+id/ivSettings"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/color_primary" />
            </com.google.android.material.card.MaterialCardView>

            <!-- App Exit Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardExitApp"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:visibility="gone"
                android:layout_marginStart="@dimen/_8sdp"
                app:cardBackgroundColor="#22000000"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/ivExitApp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="@dimen/_8sdp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/color_text_primary" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================== -->
    <!-- 2. VIEW PAGER 2 (HOSTS ALL TAB FRAGMENTS)      -->
    <!-- ============================================== -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerMain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar" />

    <!-- ============================================== -->
    <!-- 3. CUSTOM BOTTOM NAVIGATION BAR                -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Bottom Bar Background Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBottomBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_54sdp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="0dp"
            app:cardElevation="@dimen/_10sdp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 1. Home Tab -->
                <LinearLayout
                    android:id="@+id/tabHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvIconHome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏠"
                        android:textSize="@dimen/_14ssp" />

                    <TextView
                        android:id="@+id/tvNavHome"
                        style="@style/TextAppearance.LittleDeen.H5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/berlin"
                        android:text="Home"
                        android:textColor="@color/color_primary"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>

                <!-- 2. Stories Tab -->
                <LinearLayout
                    android:id="@+id/tabStories"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvIconStories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📚"
                        android:textSize="@dimen/_14ssp" />

                    <TextView
                        android:id="@+id/tvNavStories"
                        style="@style/TextAppearance.LittleDeen.H5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/berlin"
                        android:text="Learning"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>

                <!-- Center Spacer to give room for Floating Drawing Button -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2" />

                <!-- 4. Duas Tab -->
                <LinearLayout
                    android:id="@+id/tabDuas"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvIconDuas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤲"
                        android:textSize="@dimen/_14ssp" />

                    <TextView
                        android:id="@+id/tvNavDuas"
                        style="@style/TextAppearance.LittleDeen.H5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Duas"
                        android:fontFamily="@font/berlin"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>

                <!-- 5. Games Tab -->
                <LinearLayout
                    android:id="@+id/tabGames"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvIconGames"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎮"
                        android:textSize="@dimen/_14ssp" />

                    <TextView
                        android:id="@+id/tvNavGames"
                        style="@style/TextAppearance.LittleDeen.H5"
                        android:fontFamily="@font/berlin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Games"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- 3. CENTER FLOATING ELEVATED BUTTON (KIDS VIDEOS WITH CONTINUOUS PULSE) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnCenterVideos"
            android:layout_width="@dimen/_62sdp"
            android:layout_height="@dimen/_62sdp"
            android:layout_marginBottom="@dimen/_14sdp"
            app:cardBackgroundColor="@color/color_primary"
            app:cardCornerRadius="@dimen/_26sdp"
            app:cardElevation="@dimen/_10sdp"
            app:strokeColor="@color/white"
            app:strokeWidth="@dimen/_3sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Kids Video Icon -->
                <ImageView
                    android:id="@+id/ivCenterVideoIcon"
                    android:layout_width="@dimen/_62sdp"
                    android:layout_height="@dimen/_62sdp"
                    android:padding="@dimen/_1sdp"
                    android:layout_gravity="center"
                    android:contentDescription="Videos"
                    android:src="@drawable/ic_kids_video_play"
                     />

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>



    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>