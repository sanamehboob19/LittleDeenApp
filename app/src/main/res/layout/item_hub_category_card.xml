<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardHubCategory"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_100sdp"
    android:layout_marginBottom="@dimen/_10sdp"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/_20sdp"
    app:cardElevation="@dimen/_3sdp"
    app:strokeColor="@color/color_border"
    app:strokeWidth="@dimen/_1sdp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_grad_hero">

        <!-- Decorative background bubble -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="-20dp"
            android:layout_marginBottom="-20dp"
            app:cardBackgroundColor="#26FFFFFF"
            app:cardCornerRadius="45dp"
            app:cardElevation="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_16sdp">

            <!-- Emoji Badge Circle -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_52sdp"
                android:layout_height="@dimen/_52sdp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/_26sdp"
                app:cardElevation="@dimen/_3sdp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:id="@+id/tvCatEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="@dimen/_24ssp"
                    tools:text="🕌" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Category Title & Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCatTitle"
                    style="@style/TextAppearance.LittleDeen.H3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_15ssp"
                    tools:text="Islamic Cartoons" />

                <TextView
                    style="@style/TextAppearance.LittleDeen.P5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="Explore curated videos &amp; stories"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <!-- Arrow Icon -->
            <TextView
                style="@style/TextAppearance.LittleDeen.H3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/_24ssp" />

        </LinearLayout>
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>