<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- ============================================== -->
    <!-- 1. TOP HEADER BAR                              -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_52sdp"
        android:background="#FAF9FE"
        android:paddingHorizontal="@dimen/_12sdp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            app:cardBackgroundColor="@color/color_primary"
            app:cardCornerRadius="@dimen/_17sdp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_back_arrow"
                app:tint="@android:color/white" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/TextAppearance.LittleDeen.H3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Draw Pad"
                android:textColor="@color/color_text_primary"
                android:textSize="@dimen/_14ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kids Creative Canvas"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/_9ssp" />
        </LinearLayout>

        <!-- Right Actions: Rotate Screen, Save, Share -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 🔄 Screen Rotate Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnRotateScreen"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_17sdp"
                app:cardElevation="@dimen/_1sdp"
                app:strokeColor="#EAEAEA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🔄"
                    android:textSize="@dimen/_13ssp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Save Drawing -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSave"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_17sdp"
                app:cardElevation="@dimen/_1sdp"
                app:strokeColor="#EAEAEA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="💾"
                    android:textSize="@dimen/_13ssp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Share Drawing -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnShare"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_17sdp"
                app:cardElevation="@dimen/_1sdp"
                app:strokeColor="#EAEAEA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="↗️"
                    android:textSize="@dimen/_13ssp" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================== -->
    <!-- 2. DRAWING CANVAS (Middle of screen)           -->
    <!-- ============================================== -->
    <com.ccx.islamic.kids.littledeenapp.ui.customViews.DrawingView
        android:id="@+id/drawingView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/bottomDock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- ============================================== -->
    <!-- 3. BOTTOM CONTROL DOCK                         -->
    <!-- ============================================== -->
    <!-- ============================================== -->
    <!-- 3. BOTTOM CONTROL DOCK (Redesigned)            -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FAF9FE"
        android:elevation="@dimen/_10sdp"
        android:orientation="vertical"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_8sdp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ROW 1: Undo, Redo, Trash & Brush Size Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_12sdp">

            <!-- Undo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnUndo"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:strokeColor="#EAEAEA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="↩"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_15ssp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Redo -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnRedo"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginStart="@dimen/_6sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:strokeColor="#EAEAEA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="↪"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_15ssp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Clear Canvas / Trash -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTrash"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginStart="@dimen/_6sdp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:strokeColor="#EAEAEA"
                app:strokeWidth="@dimen/_1sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🗑"
                    android:textSize="@dimen/_13ssp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Stroke Size Slider -->
            <com.google.android.material.slider.Slider
                android:id="@+id/sliderStrokeSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:stepSize="2.0"
                android:value="16.0"
                android:valueFrom="4.0"
                android:valueTo="80.0"
                app:thumbColor="@color/color_primary"
                app:trackColorActive="@color/color_primary"
                app:trackColorInactive="#E0E0E0" />
        </LinearLayout>

        <!-- ROW 2: Horizontal 30 Colors Carousel -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvColors"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginTop="@dimen/_1sdp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_color_swatch" />

        <!-- ROW 3: Horizontal Tools (Eraser first, then Brush, Pencil, Shapes) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/_8sdp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 1. Eraser (Most Important - Placed First) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolEraser"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/_14sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EAEAEA"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧼"
                            android:textSize="@dimen/_14ssp" />

                        <TextView
                            android:id="@+id/tvToolEraser"
                            style="@style/TextAppearance.LittleDeen.H5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:text="Eraser"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_8ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Brush (Placed Second) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolBrush"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/_14sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EAEAEA"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🖌️"
                            android:textSize="@dimen/_14ssp" />

                        <TextView
                            android:id="@+id/tvToolBrush"
                            style="@style/TextAppearance.LittleDeen.H5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:text="Brush"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_8ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Pencil (Placed Third) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolPencil"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    app:cardBackgroundColor="@color/color_primary"
                    app:cardCornerRadius="@dimen/_14sdp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✏️"
                            android:textSize="@dimen/_14ssp" />

                        <TextView
                            android:id="@+id/tvToolPencil"
                            style="@style/TextAppearance.LittleDeen.H5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:text="Pencil"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/_8ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Line -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolLine"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/_14sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EAEAEA"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="@dimen/_14ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvToolLine"
                            style="@style/TextAppearance.LittleDeen.H5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:text="Line"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_8ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Rectangle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolRectangle"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/_14sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EAEAEA"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▭"
                            android:textSize="@dimen/_14ssp" />

                        <TextView
                            android:id="@+id/tvToolRectangle"
                            style="@style/TextAppearance.LittleDeen.H5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:text="Rectangle"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_8ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 6. Circle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/toolCircle"
                    android:layout_width="@dimen/_54sdp"
                    android:layout_height="@dimen/_46sdp"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/_14sdp"
                    app:cardElevation="0dp"
                    app:strokeColor="#EAEAEA"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="◯"
                            android:textSize="@dimen/_14ssp" />

                        <TextView
                            android:id="@+id/tvToolCircle"
                            style="@style/TextAppearance.LittleDeen.H5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:text="Circle"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_8ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>