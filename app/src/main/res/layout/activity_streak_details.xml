<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app">

    <!-- Top Header Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/_17sdp"
            app:cardElevation="@dimen/_1sdp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/_1sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Back"
                android:padding="@dimen/_8sdp"
                android:rotation="180"
                android:src="@drawable/ic_check"
                app:tint="@color/color_text_primary" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvHeaderTitle"
            style="@style/TextAppearance.LittleDeen.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Learning Streak"
            android:textColor="#E65100"
            android:textSize="@dimen/_16ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingTop="@dimen/_4sdp"
            android:paddingBottom="@dimen/_32sdp">

            <!-- HERO STREAK CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFF8E1"
                app:cardCornerRadius="@dimen/_24sdp"
                app:cardElevation="@dimen/_4sdp"
                app:strokeColor="#FFE082"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_grad_streak"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/_22sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥"
                        android:textSize="@dimen/_44ssp" />

                    <TextView
                        android:id="@+id/tvBigStreakCount"
                        style="@style/TextAppearance.LittleDeen.H2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:text="5 Days"
                        android:textColor="#E65100"
                        android:textSize="@dimen/_26ssp" />

                    <TextView
                        style="@style/TextAppearance.LittleDeen.P4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Amazing Learning Journey!"
                        android:textColor="#F57C00"
                        android:textSize="@dimen/_11ssp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STATS ROW (Longest Streak & Freezes) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:orientation="horizontal">

                <!-- Longest Streak -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="@dimen/_18sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/_14sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏆"
                            android:textSize="@dimen/_24ssp" />

                        <TextView
                            android:id="@+id/tvLongestStreak"
                            style="@style/TextAppearance.LittleDeen.H3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="12 Days"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_14ssp" />

                        <TextView
                            style="@style/TextAppearance.LittleDeen.P5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Longest Streak"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="@dimen/_9ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Streak Freezes -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="@dimen/_18sdp"
                    app:cardElevation="@dimen/_2sdp"
                    app:strokeColor="@color/color_border"
                    app:strokeWidth="@dimen/_1sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/_14sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❄️"
                            android:textSize="@dimen/_24ssp" />

                        <TextView
                            android:id="@+id/tvFreezesCount"
                            style="@style/TextAppearance.LittleDeen.H3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_4sdp"
                            android:text="1 / 2"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_14ssp" />

                        <TextView
                            style="@style/TextAppearance.LittleDeen.P5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Streak Freezes"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="@dimen/_9ssp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- NEXT MILESTONE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                app:cardBackgroundColor="@color/color_surface"
                app:cardCornerRadius="@dimen/_18sdp"
                app:cardElevation="@dimen/_2sdp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="@dimen/_1sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐"
                        android:textSize="@dimen/_28ssp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.LittleDeen.H4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Next Milestone: Super Learner"
                            android:textColor="@color/color_text_primary"
                            android:textSize="@dimen/_13ssp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_2sdp"
                            android:text="Reach 7 days to unlock reward badge!"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="@dimen/_10ssp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>