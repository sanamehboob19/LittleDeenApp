<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPlaylistRow"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_98sdp"
    android:layout_marginBottom="@dimen/_12sdp"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/_18sdp"
    app:cardElevation="@dimen/_3sdp"
    app:strokeColor="@color/color_border"
    app:strokeWidth="@dimen/_1sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- LEFT HALF: LARGE PLAYLIST COVER -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.6"
            app:cardBackgroundColor="@color/color_primary_light"
            app:cardCornerRadius="@dimen/_16sdp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Default Emoji -->
                <TextView
                    android:id="@+id/tvPlaylistEmoji"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="📂"
                    android:textSize="@dimen/_38ssp"
                    tools:ignore="HardcodedText" />

                <!-- Custom Cover Image -->
                <ImageView
                    android:id="@+id/ivPlaylistCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Playlist cover"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- RIGHT HALF: PLAYLIST DETAILS -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_10sdp"
            android:paddingVertical="@dimen/_10sdp">

            <!-- Playlist Name + Selection -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlaylistName"
                    style="@style/TextAppearance.LittleDeen.H4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/_13ssp"
                    tools:text="Bedtime Stories" />

                <CheckBox
                    android:id="@+id/checkboxSelect"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:buttonTint="@color/color_primary"
                    android:clickable="false"
                    android:focusable="false"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvSelectHint"
                    style="@style/TextAppearance.LittleDeen.H4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:text="›"
                    android:textColor="@color/color_text_tertiary"
                    android:textSize="@dimen/_22ssp" />

            </LinearLayout>

            <!-- Small Accent Divider -->

            <View
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_2sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_marginBottom="@dimen/_7sdp"
                android:background="@color/color_primary" />

            <!-- Video Count -->

            <TextView
                android:id="@+id/tvVideoCount"
                style="@style/TextAppearance.LittleDeen.P5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3 videos"
                android:textColor="@color/color_primary"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- Creation Date -->

            <TextView
                android:id="@+id/tvCreatedDate"
                style="@style/TextAppearance.LittleDeen.P5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/_10ssp"
                tools:text="Created Today" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
