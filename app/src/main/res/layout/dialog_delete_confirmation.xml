<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/_20sdp"
    app:cardElevation="@dimen/_8sdp"
    app:strokeColor="@color/color_border"
    app:strokeWidth="@dimen/_1sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/_18sdp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑️"
            android:textSize="@dimen/_32ssp" />

        <TextView
            android:id="@+id/tvDeleteTitle"
            style="@style/TextAppearance.LittleDeen.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:text="Clear History"
            android:textColor="@color/color_text_primary" />

        <TextView
            android:id="@+id/tvDeleteMessage"
            style="@style/TextAppearance.LittleDeen.P4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:gravity="center"
            android:text="Are you sure you want to delete these records?"
            android:textColor="@color/color_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_16sdp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelDelete"
                style="@style/TextAppearance.LittleDeen.H5"
                android:layout_width="0dp"
                android:layout_height="@dimen/_42sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:layout_weight="1"
                android:backgroundTint="#F5F5F5"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/color_text_primary"
                app:cornerRadius="@dimen/_12sdp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmDelete"
                style="@style/TextAppearance.LittleDeen.H5"
                android:layout_width="0dp"
                android:layout_height="@dimen/_42sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_weight="1"
                android:backgroundTint="@color/color_primary"
                android:text="Delete"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="@dimen/_12sdp"
                app:elevation="@dimen/_2sdp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>