<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardDuaRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_100sdp"
    android:layout_marginHorizontal="@dimen/_2sdp"
    android:layout_marginBottom="@dimen/_12sdp"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/_24sdp"
    app:cardElevation="@dimen/_5sdp"
    app:strokeColor="@color/color_primary_light"
    app:strokeWidth="@dimen/_2sdp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_grad_hero">

        <!-- Decorative corner circle -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="-34dp"
            android:layout_marginEnd="-26dp"
            app:cardBackgroundColor="#4D81C784"
            app:cardCornerRadius="45dp"
            app:cardElevation="0dp" />

        <!-- Tiny sparkle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:alpha="0.8"
            android:text="✨"
            android:textSize="@dimen/_10ssp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Left Side: Illustration in a rounded, framed tile -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:padding="@dimen/_8sdp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="@color/color_primary_light"
                    app:cardCornerRadius="@dimen/_18sdp"
                    app:cardElevation="@dimen/_3sdp"
                    app:strokeColor="#FFFFFF"
                    app:strokeWidth="@dimen/_2sdp">

                    <ImageView
                        android:id="@+id/ivDuaIllustration"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Dua Art"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/avatar_girl_1" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <!-- Right Side: Title, Subtitle, chip & Play Button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_4sdp"
                android:paddingEnd="@dimen/_12sdp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_3sdp"
                        app:cardBackgroundColor="#FFF1C2"
                        app:cardCornerRadius="@dimen/_8sdp"
                        app:cardElevation="0dp">

                        <TextView
                            style="@style/TextAppearance.LittleDeen.P5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/_6sdp"
                            android:paddingVertical="@dimen/_1sdp"
                            android:text="🎧 Tap to listen"
                            android:textColor="#8A5A00"
                            android:textSize="@dimen/_8ssp" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvDuaTitle"
                        style="@style/TextAppearance.LittleDeen.H3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/color_text_primary"
                        android:textSize="@dimen/_14ssp"
                        tools:text="Morning Dua" />

                    <TextView
                        android:id="@+id/tvDuaSubtitle"
                        style="@style/TextAppearance.LittleDeen.P5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/_10ssp"
                        tools:text="Start your day with Allah" />
                </LinearLayout>

                <!-- Play Audio Button Badge with glow ring -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="@dimen/_46sdp"
                        android:layout_height="@dimen/_46sdp"
                        android:layout_gravity="center"
                        app:cardBackgroundColor="#26E91E63"
                        app:cardCornerRadius="@dimen/_23sdp"
                        app:cardElevation="0dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPlayDua"
                        android:layout_width="@dimen/_38sdp"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_gravity="center"
                        app:cardBackgroundColor="#E91E63"
                        app:cardCornerRadius="@dimen/_19sdp"
                        app:cardElevation="@dimen/_6sdp"
                        app:strokeColor="#FFFFFF"
                        app:strokeWidth="@dimen/_2sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="▶"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12ssp" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>