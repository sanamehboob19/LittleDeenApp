<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app">

    <!-- ============================================== -->
    <!-- 1. TOP HEADER BAR (Back + Search Bar)          -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingBottom="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/_18sdp"
            app:cardElevation="@dimen/_1sdp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/_1sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Back"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/color_text_primary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Search Bar Input Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCategorySearch"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_8sdp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="@dimen/_20sdp"
            app:cardElevation="@dimen/_1sdp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="@dimen/_1sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_12sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    style="@style/TextAppearance.LittleDeen.P4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:text="Search in categories..."
                    android:textColor="@color/color_text_tertiary"
                    android:textSize="@dimen/_11ssp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================== -->
    <!-- 2. HORIZONTAL CHIPS BAR FOR CATEGORIES         -->
    <!-- ============================================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategoryScreenChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_4sdp"
        app:layout_constraintTop_toBottomOf="@id/headerBar" />

    <!-- ============================================== -->
    <!-- 3. VIEW PAGER 2 (FINGER SWIPE BETWEEN CATEGORIES) -->
    <!-- ============================================== -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerCategories"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_4sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvCategoryScreenChips" />

    <!-- ============================================== -->
    <!-- 4. PULL-DOWN / SWIPE HINT OVERLAY ANIMATION    -->
    <!-- ============================================== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSwipeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_24sdp"
        app:cardBackgroundColor="#CC000000"
        app:cardCornerRadius="@dimen/_16sdp"
        app:cardElevation="@dimen/_4sdp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            style="@style/TextAppearance.LittleDeen.H5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_6sdp"
            android:text="👈 Swipe left/right for more categories 👉"
            android:textColor="@color/white"
            android:textSize="@dimen/_10ssp" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>